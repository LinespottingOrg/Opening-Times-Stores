<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>OpeningTimesWidget.Program</StartupObject>
    <RootNamespace>OpeningTimesWidget</RootNamespace>
    <AssemblyName>OpeningTimesWidget</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Opening Times - Stores</Product>
    <Company>Linespotting</Company>
    <Authors>Linespotting</Authors>
    <Description>Desktop widget for store opening hours, specials, and sun times.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Set when you have a multi-size .ico under Assets -->
    <!-- <ApplicationIcon>Assets\app.ico</ApplicationIcon> -->
  </PropertyGroup>
  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

